# LRU CACHE
# ═══════════════════════════════════════════════════════════════════════════
class LRU:
def __init__(self, cap=300):
self.cap=cap; self.d={}; self.lk=threading.RLock()
def get(self,k):
with self.lk:
if k in self.d:
v=self.d.pop(k); self.d[k]=v; return v
return None
def put(self,k,v):
with self.lk:
if k in self.d: self.d.pop(k)
elif len(self.d)>=self.cap: self.d.pop(next(iter(self.d)))
self.d[k]=v
def size(self):
with self.lk: return len(self.d)

