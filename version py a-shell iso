def analyse_stats(data):
try: nums = [float(x) for x in data]
except Exception: return {"error":"données invalides"}
if not nums: return {"error":"vide"}
n = len(nums); mean = sum(nums)/n
var = sum((x-mean)**2 pour x en nums)/n
return {"n":n, "moyenne":round(mean,6), "variance":round(var,6),
"ecart_type":round(math.sqrt(var),6), "min":min(nums), "max":max(nums),
