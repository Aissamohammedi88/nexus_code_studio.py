def detecter_langage(code, filename=""):
if filename:
ext = os.path.splitext(filename)[1].lower()
name = os.path.basename(filename).lower()
for lang, info in LANGUAGES.items():
for e in info.get("ext", []):
if ext == e.lower() or name == e.lower():
return lang
cl = code[:6000].lower()
kws = {
"html": ["<!doctype", "<html", "<div"], "css": ["{", "color:", "@media"],
"javascript": ["function ", "const ", "=>", "console.log"],
"typescript": ["interface ", ": string", "type "],
"python": ["def ", "import ", "print("], "rust": ["fn ", "let mut", "println!"],
"go": ["package ", "func ", "fmt."], "java": ["public class", "system.out"],
"cpp": ["#include", "std::"], "c": ["#include", "int main"],
"bash": ["#!/bin/bash", "echo ", "fi"], "sql": ["select ", "from "],
"yaml": ["---", "apiversion:", "kind:"], "json": ['":"', "{", "}"],
"markdown": ["# ", "```", "- ["], "dockerfile": ["from ", "run "],
"cobol": ["identification division", "procedure division"],
"fortran": ["program ", "subroutine ", "implicit none"],
"prolog": [":-", "?-"], "lisp": ["(defun ", "(def ", "(car "],
"brainfuck": ["+++++", "-----", "[", "]"],
"pascal": ["program ", "begin", "end."],
"ada": ["procedure ", "package ", "begin"],
"forth": [": ", " ;"], "apl": ["⍴", "⍳", "⌈"],
}
scores = {}
for lang, pats in kws.items():
s = sum(1 for p in pats if p in cl)
if s > 0: scores[lang] = s
if scores:
best = max(scores.items(), key=lambda x: x[1])
if best[1] >= 2: return best[0]
return "text"

