if (/^\s*fn\s+\w+\s*\(/m.test(code)) return 'rust';
if (/^\s*public\s+class/m.test(code)) return 'java';
if (/^\s*#include\s*</m.test(code)) return 'c';
if (/^\s*namespace\s+\w+/m.test(code)) return 'cpp';
if (/^\s*<\?php/i.test(code)) return 'php';
if (/^\s*require\s+['"]/m.test(code)) return 'ruby';
if (/^\s*SELECT\s+.+FROM/is.test(code)) return 'sql';
if (/^\s*FROM\s+\w+/im.test(code)) return 'dockerfile';
if (/^\s*\{[^}]*=/.test(code)) return 'nix';
if (/^\s*#\s+\S/m.test(code) && code.split('\n').every(l => /^\s*(#|\*|-|\d+\.|$)/.test(l))) return 'markdown';
if (/^\s*@import|^\s*\.[\w-]+\s*\{/m.test(code)) return 'css';
if (/^\s*(const|let|var|function)\s+/m.test(code)) return 'javascript';
if (/^\s*<\w+[^>]*>/.test(code)) return 'html';

return 'text';
}

