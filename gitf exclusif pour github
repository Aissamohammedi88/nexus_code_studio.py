function beautify() {
// Beautification basique : indentation cohérente
const code = editor.value;
const lang = detectLang(code);
if (lang === 'json') { formaterJSON(); return; }
const lines = code.split('\n');
let indent = 0;
const out = [];
for (let line of lines) {
const trimmed = line.trim();
if (trimmed.startsWith('}') || trimmed.startsWith(']') || trimmed.startsWith(')')) indent = Math.max(0, indent - 1);
if (trimmed) out.push(' '.repeat(indent) + trimmed);
else out.push('');
if (trimmed.endsWith('{') || trimmed.endsWith('[') || trimmed.endsWith('(')) indent++;
}
editor.value = out.join('\n');
updatePreview();
}

