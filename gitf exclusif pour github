# HANDLER HTTP
# ═══════════════════════════════════════════════════════════════════════════

class Handler(BaseHTTPRequestHandler):
server_version = "NexusCodeStudio/" + VERSION
protocol_version = "HTTP/1.1"

def log_message(self, *a):
pass

def _send(self, code, body, ctype="text/html; charset=utf-8"):
if isinstance(body, str):
body = body.encode("utf-8")
try:
self.send_response(code)
self.send_header("Content-Type", ctype)
self.send_header("Content-Length", str(len(body)))
self.send_header("Access-Control-Allow-Origin", "*")
self.send_header("Cache-Control", "no-store")
self.end_headers()
self.wfile.write(body)
except (BrokenPipeError, ConnectionResetError):
pass

def _json(self, code, obj):
self._send(code, json.dumps(obj, indent=2, ensure_ascii=False, default=str),
"application/json; charset=utf-8")

def _body(self):
try:
n = int(self.headers.get("Content-Length", "0") or "0")
except Exception:
n = 0
if n <= 0 or n > 10_000_000:
return {}
try:
return json.loads(self.rfile.read(n).decode("utf-8", "ignore") or "{}")
except Exception:
return {}

def do_GET(self):
p = urllib.parse.urlparse(self.path)
path = p.path

if path in ("/", "/index.html"):
return self._send(200, HTML)

if path == "/api/status":
return self._json(200, {
"ok": True, "service": "NEXUS CODE STUDIO",
"version": VERSION, "auteur": AUTEUR,
"licence": LICENCE, "port": PORT,
"pid": os.getpid(),
"uptime_s": int(time.time() - START_TS),
"langages": list(LANGAGES.keys()),
})

if path == "/api/langs":
return self._json(200, {"ok": True, "langages": LANGAGES})

if path == "/api/exemples":
return self._json(200, {"ok": True, "exemples": list(LANGAGES.keys())})

return self._send(404, "404 — Not found")

def do_POST(self):
p = urllib.parse.urlparse(self.path)
path = p.path
data = self._body()

if path == "/api/run":
code = data.get("code", "")
lang = data.get("lang", "text")
if lang == "python" or (lang == "text" and code.startswith("#!")):
r = executer_python(code)
elif lang == "bash":
r = executer_bash(code)
elif lang == "javascript":
r = executer_js(code)
elif lang == "html":
r = {"ok": True, "rc": 0, "stdout": "HTML rendu dans le navigateur", "stderr": ""}
else:
r = {"ok": False, "err": "Exécution non supportée pour : " + lang}
return self._json(200, r)

if path == "/api/image":
code = data.get("code", "")
lang = data.get("lang", "text")
titre = data.get("titre", "Code")
svg = generer_svg_code(code, lang, titre)
return self._json(200, {"ok": True, "svg": svg, "lang": lang})

if path == "/api/save":
nom = re.sub(r"[^a-zA-Z0-9_.-]", "_", data.get("nom", "code"))[:60]
code = data.get("code", "")
lang = data.get("lang", "text")
path_file = os.path.join(PROJECTS, nom + "." + lang)
try:
with open(path_file, "w", encoding="utf-8") as f:
f.write(code)
return self._json(200, {"ok": True, "file": path_file})
except OSError as e:
return self._json(500, {"ok": False, "err": str(e)[:150]})

return self._json(404, {"ok": False, "err": "route inconnue"})

def do_OPTIONS(self):
try:
self.send_response(204)
self.send_header("Access-Control-Allow-Origin", "*")
self.send_header("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
self.send_header("Access-Control-Allow-Headers", "*")
self.send_header("Content-Length", "0")
self.end_headers()
except Exception:
pass


