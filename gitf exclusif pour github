def generer_svg_code(code, langage, titre="Code", largeur=800):
"""Génère un SVG stylisé du code (comme GitHub social preview)."""
lignes = code.split("\n")[:40]

# Échappe HTML
def esc(s):
return (s.replace("&", "&amp;")
.replace("<", "&lt;")
.replace(">", "&gt;"))

hauteur_ligne = 22
padding = 30
header_h = 50
hauteur = header_h + padding * 2 + len(lignes) * hauteur_ligne

# Couleurs par langage
couleurs = {
"python": "#3776ab",
"javascript": "#f7df1e",
"typescript": "#3178c6",
"html": "#e34c26",
"css": "#264de4",
"bash": "#4eaa25",
"yaml": "#cb171e",
"json": "#292929",
"markdown": "#083fa1",
"rust": "#dea584",
"go": "#00add8",
"java": "#b07219",
"c": "#555555",
"cpp": "#f34b7d",
"php": "#777bb4",
"ruby": "#701516",
"nix": "#5277c3",
"text": "#666666",
}
accent = couleurs.get(langage, "#00d4ff")

svg = []
svg.append('<?xml version="1.0" encoding="UTF-8"?>')
svg.append('<svg xmlns="http://www.w3.org/2000/svg" width="{}" height="{}" viewBox="0 0 {} {}">'.format(largeur, hauteur, largeur, hauteur))
svg.append('<defs>')
svg.append('<linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">')
svg.append('<stop offset="0%" stop-color="#02040a"/>')
svg.append('<stop offset="100%" stop-color="#0a1018"/>')
svg.append('</linearGradient>')
svg.append('</defs>')

# Fond
svg.append('<rect width="100%" height="100%" fill="url(#bg)" rx="12"/>')
svg.append('<rect x="0" y="0" width="100%" height="4" fill="{}"/>'.format(accent))

# Header
svg.append('<circle cx="25" cy="25" r="6" fill="#ff5f56"/>')
svg.append('<circle cx="45" cy="25" r="6" fill="#ffbd2e"/>')
svg.append('<circle cx="65" cy="25" r="6" fill="#27c93f"/>')
svg.append('<text x="90" y="30" font-family="Menlo,monospace" font-size="13" fill="#6a7a8a">{}</text>'.format(esc(titre)))
svg.append('<text x="{}" y="30" font-family="Menlo,monospace" font-size="11" fill="{}" text-anchor="end">{}</text>'.format(largeur - 30, accent, langage.upper()))

# Lignes de code
for i, ligne in enumerate(lignes):
y = header_h + padding + (i + 1) * hauteur_ligne - 6
num = '{:>3}'.format(i + 1)
svg.append('<text x="20" y="{}" font-family="Menlo,monospace" font-size="12" fill="#3a4a5a">{}</text>'.format(y, num))
# Échappe et colorisation simple
l = esc(ligne)[:110]
svg.append('<text x="60" y="{}" font-family="Menlo,monospace" font-size="13" fill="#e0e8f0" xml:space="preserve">{}</text>'.format(y, l))

svg.append('</svg>')
return "\n".join(svg)


