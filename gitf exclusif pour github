def executer_python(code, timeout=10):
"""Exécute du code Python en sandbox."""
tmp = os.path.join(TMP_DIR, "run_" + uuid.uuid4().hex[:8] + ".py")
try:
with open(tmp, "w", encoding="utf-8") as f:
f.write(code)
r = subprocess.run(
[sys.executable, tmp],
capture_output=True, text=True, timeout=timeout,
cwd=TMP_DIR
)
return {
"ok": r.returncode == 0,
"rc": r.returncode,
"stdout": r.stdout[-10000:],
"stderr": r.stderr[-5000:],
}
except subprocess.TimeoutExpired:
return {"ok": False, "err": "timeout " + str(timeout) + "s"}
except Exception as e:
return {"ok": False, "err": str(e)[:200]}
finally:
try:
os.unlink(tmp)
except OSError:
pass


