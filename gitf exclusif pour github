def detecter_langage(code, filename=""):
"""Détecte le langage de programmation."""
# 1. Par extension de fichier
if filename:
ext = filename.rsplit(".", 1)[-1].lower() if "." in filename else filename.lower()
for lang, info in LANGAGES.items():
if ext in info["ext"]:
return lang

# 2. Par motifs dans le code
for pattern, lang in LANG_PATTERNS:
if pattern.search(code):
return lang

return "text"


